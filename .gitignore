# Python이 자동으로 만드는 캐시 파일
__pycache__/
*.py[cod]

# 가상환경 (venv 등)
.venv/
venv/
env/

# 비밀번호, API 키 등을 담는 파일
.env

# 편집기 설정
.vscode/
.idea/

# Windows / macOS가 자동으로 만드는 파일
Thumbs.db
desktop.ini
.DS_Store

# Office 파일을 열어 둘 때 생기는 임시 파일
~$*

# 출판 논문 원문 (저작권) - 그림 캡처(png)만 올리고 원문은 올리지 않음
*.pdf
새 폴더/10.1063_1.322330.html

# 올리지 않을 파일이 더 있으면 아래에 추가하세요. 예:
# raw_data/
# *.xlsx
